# HTTP/1.1 tokens and the headers the server reads, for -dict=.
crlf="\x0d\x0a"
http11="HTTP/1.1"
get="GET "
post="POST "
head="HEAD "
content_length="Content-Length: "
transfer_encoding="Transfer-Encoding: chunked"
expect="Expect: 100-continue"
authorization="Authorization: Bearer contrastapi_"
x_api_key="X-API-Key: "
x_real_ip="X-Real-IP: "
mcp_method="Mcp-Method: "
mcp_name="Mcp-Name: "
mcp_protocol="MCP-Protocol-Version: "
path_mcp="/mcp"
path_cve="/cve_lookup/"
