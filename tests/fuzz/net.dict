# The keys, tags and directives the network parsers read, for -dict= (libFuzzer dictionary format).
nul="\x00"
rdap_object_class="\"objectClassName\""
rdap_domain="\"domain\""
rdap_ldh_name="\"ldhName\""
rdap_nameservers="\"nameservers\""
rdap_status="\"status\""
rdap_events="\"events\""
rdap_event_action="\"eventAction\""
rdap_event_date="\"eventDate\""
rdap_entities="\"entities\""
rdap_roles="\"roles\""
rdap_vcard="\"vcardArray\""
spf="v=spf1"
spf_include="include:"
spf_redirect="redirect="
spf_ip4="ip4:"
spf_all="-all"
dmarc="v=DMARC1"
dmarc_policy="p=reject"
dmarc_rua="rua=mailto:"
dmarc_pct="pct="
dkim="v=DKIM1"
dkim_rsa="k=rsa"
dkim_ed25519="k=ed25519"
dkim_key="p="
dkim_test="t=y"
cookie_secure="; Secure"
cookie_httponly="; HttpOnly"
cookie_samesite="; SameSite="
cookie_host_prefix="__Host-"
cookie_secure_prefix="__Secure-"
hsts="max-age="
csp="default-src "
cvss31="CVSS:3.1/"
cvss40="CVSS:4.0/"
cvss_av="AV:N"
robots_agent="User-agent:"
robots_disallow="Disallow:"
robots_allow="Allow:"
robots_sitemap="Sitemap:"
securitytxt_contact="Contact:"
securitytxt_expires="Expires:"
whois_registrar="Registrar:"
whois_status="Status:"
